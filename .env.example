# ==========================================
# Cấu hình Reader (Outlook OTP Automation)
# ==========================================

# Địa chỉ và cổng lắng nghe
READER_HOST=127.0.0.1
READER_PORT=5678

# Token bảo mật (để trống nếu không muốn yêu cầu token khi truy cập)
# Nếu đặt token, truy cập Web bằng: http://localhost:5678/?token=YOUR_TOKEN
# Hoặc truyền header HTTP: X-Reader-Token: YOUR_TOKEN
READER_TOKEN=

# Chế độ chạy trình duyệt: true (ẩn giao diện), false (hiện cửa sổ để giải CAPTCHA / 2FA)
READER_HEADLESS=false

# Kênh trình duyệt: để trống để dùng Chromium của Playwright, hoặc 'chrome' để dùng Google Chrome có sẵn trên máy
READER_BROWSER_CHANNEL=

# Thư mục lưu phiên đăng nhập (Profile) riêng cho từng email
READER_PROFILES=./.profiles

# Cấu hình Proxy (tuỳ chọn)
# Hỗ trợ HTTP Proxy: http://username:password@host:port
# SOCKS5: socks5://host:port (Chromium không hỗ trợ user/pass cho SOCKS5)
READER_PROXY=

# Lệnh shell đổi IP khi Proxy chết hoặc bị Microsoft chặn rủi ro (tuỳ chọn)
READER_PROXY_ROTATE=

# Webhook nhận kết quả khi có mã OTP (tuỳ chọn)
READER_WEBHOOK=
READER_WEBHOOK_SECRET=

# Cấu hình gửi mail báo mã qua SMTP (tuỳ chọn)
READER_SMTP_HOST=
READER_SMTP_PORT=587
READER_SMTP_USER=
READER_SMTP_PASSWORD=
READER_MAIL_FROM=
READER_MAIL_TO=

# Thời gian điều chỉnh (giây)
READER_POLL_SECONDS=5
READER_REFRESH_SECONDS=120
READER_TIMEOUT_SECONDS=180
READER_LOGIN_TIMEOUT_SECONDS=90
